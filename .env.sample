POSTGRES_URL=postgres://nap:nap_dev_password@localhost:5432/nap
REDIS_URL=redis://localhost:6379

PORT=5050

# Email delivery:
# - local dev with both SMTP and Resend empty -> emails are logged to console
# - set SMTP_* to use direct SMTP delivery
# - or leave SMTP_* empty and set RESEND_API_KEY/RESEND_FROM to use Resend HTTPS delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=noreply@nap.us.gov
SMTP_BCC=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

EDITOR_URL_PATTERN=http://localhost:3000/bal/<id>/<token>

API_URL=http://localhost:5050
API_DEPOT_URL=http://localhost:5001
API_DEPOT_CLIENT_ID=
API_DEPOT_CLIENT_SECRET=
BAN_API_URL=
API_ETABLISSEMENTS_PUBLIC=
API_SIGNALEMENT_URL=
API_SIGNALEMENT_CLIENT_SECRET=
API_ANNUAIRE_DES_COLLECTIVITES=

S3_REGION=
S3_ENDPOINT=
S3_CONTAINER_FILAIRES_DE_VOIE=
S3_CONTAINER_GENERATED_FILES=
S3_ACCESS_KEY=
S3_SECRET_KEY=
EXPORT_FILAIRES_DE_VOIE_FILE_NAME=dev_export-filaires-de-voie.json

RESET_COMMUNES_FOR_WEBINAIRE=
